---
import { siteData } from '../data/content';
import SkillCategory from './SkillCategory.astro';
---

<section id="skills" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <div class="text-center mb-16 reveal">
      <p class="text-[12px] tracking-[0.2em] uppercase text-[var(--text-tertiary)] font-medium mb-3">Skills</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">技术栈</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal-stagger">
      {siteData.skills.map((s) => (
        <SkillCategory skill={s} />
      ))}
    </div>
  </div>
</section>
