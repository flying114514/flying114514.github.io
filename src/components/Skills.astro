---
import { siteData } from '../data/content';
import SkillCategory from './SkillCategory.astro';
---

<section id="skills" class="py-24 px-6 relative bg-[var(--color-surface)]/50">
  <!-- 装饰背景 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-1/4 w-1/3 h-1/2 bg-[var(--color-accent)]/5 rounded-full blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-5xl relative z-10">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">技术栈</h2>
      <p class="text-sm text-[var(--color-text-muted)] tracking-widest uppercase">Skills</p>
    </div>

    <!-- 技能网格 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {siteData.skills.map((skill) => (
        <SkillCategory skill={skill} />
      ))}
    </div>
  </div>
</section>
