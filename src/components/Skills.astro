---
import { siteData } from '../data/content';
import SkillCategory from './SkillCategory.astro';
---

<section id="skills" class="py-16 sm:py-20 px-6 bg-[var(--background-secondary)]">
  <div class="mx-auto max-w-6xl">
    <div class="text-center mb-12 reveal">
      <div class="section-label">Skills</div>
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-light tracking-[-0.03em] leading-[1.1] mb-4">
        <em class="text-italics">What</em> I use
      </h2>
      <p class="text-xs text-[var(--muted)] font-mono uppercase tracking-wider">
        Backend · AI Agent · Distributed Systems
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal-stagger">
      {siteData.skills.map((s) => (
        <SkillCategory skill={s} />
      ))}
    </div>
  </div>
</section>
