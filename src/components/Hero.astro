---
import { siteData } from '../data/content';
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <!-- 装饰背景 -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-[var(--color-accent)]/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-teal-300/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
    <!-- 欢迎语 -->
    <p class="text-sm tracking-widest uppercase mb-4 text-[var(--color-text-muted)] animate-on-scroll visible">
      Welcome
    </p>

    <!-- 主标题 -->
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 leading-tight">
      Hi, I'm <span class="text-[var(--color-accent)]">{siteData.name}</span>
    </h1>
    <p class="text-lg md:text-xl text-[var(--color-text-muted)] mb-2 font-medium">
      {siteData.tagline}
    </p>
    <p class="text-sm text-[var(--color-text-muted)]/70 mb-8">
      {siteData.school} · {siteData.major}
    </p>

    <!-- CTA 按钮 -->
    <div class="flex items-center justify-center gap-4">
      <a
        href="#projects"
        class="px-6 py-2.5 bg-[var(--color-accent)] text-white rounded-lg text-sm font-medium transition-all duration-200 hover:bg-[var(--color-accent-hover)] hover:shadow-lg hover:shadow-[var(--color-accent)]/25"
      >
        查看项目
      </a>
      <a
        href="#contact"
        class="px-6 py-2.5 border border-[var(--color-border)] rounded-lg text-sm font-medium transition-all duration-200 text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-accent)]/50 hover:bg-[var(--color-surface-hover)]"
      >
        联系我
      </a>
    </div>
  </div>

  <!-- 底部滚动指示箭头 -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg
      class="w-6 h-6 text-[var(--color-text-muted)]"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"
      />
    </svg>
  </div>
</section>
