---
import { siteData } from '../data/content';

const techStack = [
  'Java 21', 'Spring Boot', 'Spring Cloud', 'Kafka', 'Redis',
  'PostgreSQL', 'pgvector', 'LangChain', 'SpringAI', 'RAG',
  'Docker', 'FastAPI', 'Python', 'gRPC', 'MyBatis',
];
---

<section id="hero" class="relative overflow-hidden">
  <!-- Animated gradient blobs -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="gradient-blob gradient-blob-1 w-[600px] h-[600px] top-1/3 left-1/4"></div>
    <div class="gradient-blob gradient-blob-2 w-[500px] h-[500px] bottom-1/4 right-1/4"></div>
    <div class="gradient-blob gradient-blob-3 w-[400px] h-[400px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
  </div>
  <div class="noise-overlay -z-10" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 py-32 sm:py-40 lg:py-52 text-center">
    <div class="reveal mb-8">
      <div class="promo-bar">
        <span class="promo-dot"></span>
        Available for hire · 2026
      </div>
    </div>

    <h1 class="reveal text-[clamp(2.5rem,7vw,5.5rem)] font-light leading-[1.08] tracking-[-0.03em] mb-5">
      <em class="text-italics">Build</em> the future,<br />
      <em class="text-italics">one</em> agent at a time.
    </h1>

    <div class="reveal max-w-lg mx-auto mb-8">
      <p class="text-base sm:text-lg text-[var(--muted-foreground)] leading-relaxed">
        {siteData.tagline} &mdash; {siteData.name}
      </p>
      <p class="mt-2 text-sm text-[var(--muted)] font-mono">
        {siteData.school} · {siteData.major} · 睿创微纳 实习中
      </p>
    </div>

    <div class="reveal flex items-center justify-center gap-3 flex-wrap mb-14">
      <div class="glowing-border">
        <a href="#projects" class="btn btn-primary group relative z-10">
          View Projects
          <svg class="w-4 h-4 transition-transform duration-[var(--duration-fast)] group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
      <a href="#contact" class="btn btn-secondary">Get in Touch</a>
    </div>

    <!-- Tech marquee -->
    <div class="reveal marquee-container py-3">
      <div class="marquee-track">
        {[...techStack, ...techStack].map((tech) => (
          <span class="tag whitespace-nowrap">{tech}</span>
        ))}
      </div>
    </div>
  </div>
</section>
