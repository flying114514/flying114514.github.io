---
import { siteData } from '../data/content';
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden px-6"
>
  <!-- Ambient background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/3 -left-32 w-[500px] h-[500px] bg-teal-200/20 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/4 -right-32 w-[400px] h-[400px] bg-teal-400/10 rounded-full blur-[100px]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-teal-100/10 rounded-full blur-[150px]"></div>
  </div>

  <div class="relative z-10 text-center max-w-2xl mx-auto reveal is-visible">
    <p class="text-[13px] tracking-[0.2em] uppercase mb-5 text-[var(--text-tertiary)] font-medium">
      Portfolio
    </p>

    <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight mb-5 leading-[1.05]">
      Hi, I&rsquo;m
      <span class="text-[var(--accent)]">{siteData.name}</span>
    </h1>

    <p class="text-lg sm:text-xl text-[var(--text-secondary)] mb-3 font-medium">
      {siteData.tagline}
    </p>
    <p class="text-[15px] text-[var(--text-tertiary)] mb-10">
      {siteData.school} &middot; {siteData.major}
    </p>

    <div class="flex items-center justify-center gap-3">
      <a href="#projects" class="btn btn-primary">查看项目</a>
      <a href="#contact" class="btn btn-secondary">联系我</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2">
    <svg
      class="w-5 h-5 text-[var(--text-tertiary)] animate-bounce"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
