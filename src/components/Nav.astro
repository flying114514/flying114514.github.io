---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { id: 'hero', label: 'Home', cn: '首页' },
  { id: 'projects', label: 'Projects', cn: '项目' },
  { id: 'experience', label: 'Experience', cn: '经历' },
  { id: 'skills', label: 'Skills', cn: '技能' },
  { id: 'contact', label: 'Contact', cn: '联系' },
];
---

<header class="fixed top-0 left-0 right-0 z-50">
  <div class="mx-auto max-w-6xl flex items-center justify-between px-6 lg:px-8 h-16">
    <!-- Logo -->
    <a
      href="#hero"
      class="font-mono text-sm font-medium tracking-tight text-[var(--text)] opacity-80 hover:opacity-100 transition-opacity duration-[var(--duration-fast)]"
    >
      LH
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8">
      {links.map((l) => (
        <a
          href={`#${l.id}`}
          class="nav-link-style"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Right group -->
    <div class="flex items-center gap-4">
      <ThemeToggle />
      <!-- Mobile menu button -->
      <button
        id="menu-btn"
        class="md:hidden flex flex-col gap-1.5 p-2 -mr-2"
        aria-label="菜单"
      >
        <span id="bar1" class="menu-bar"></span>
        <span id="bar2" class="menu-bar"></span>
        <span id="bar3" class="menu-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="md:hidden hidden mx-6 mt-1 rounded-xl bg-[var(--surface)] border border-[var(--border)] shadow-[var(--shadow-xl)] overflow-hidden backdrop-blur-xl">
    <div class="py-3 px-3 flex flex-col gap-1">
      {links.map((l) => (
        <a
          href={`#${l.id}`}
          class="mobile-link flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--surface-hover)] transition-colors duration-[var(--duration-fast)]"
        >
          <span>{l.label}</span>
          <span class="text-xs text-[var(--text-tertiary)]">{l.cn}</span>
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1')!;
  const bar2 = document.getElementById('bar2')!;
  const bar3 = document.getElementById('bar3')!;

  let open = false;
  menuBtn?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);

    if (open) {
      bar1.style.transform = 'translate(3px, -1px) rotate(45deg)';
      bar2.style.opacity = '0';
      bar3.style.transform = 'translate(3px, 1px) rotate(-45deg)';
    } else {
      bar1.style.transform = 'none';
      bar2.style.opacity = '1';
      bar3.style.transform = 'none';
    }
  });

  document.querySelectorAll('.mobile-link').forEach((l) => {
    l.addEventListener('click', () => {
      open = false;
      menu?.classList.add('hidden');
      bar1.style.transform = 'none';
      bar2.style.opacity = '1';
      bar3.style.transform = 'none';
    });
  });
</script>
