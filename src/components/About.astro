---
import { siteData } from '../data/content';
---

<section id="about" class="py-16 sm:py-20 px-6">
  <div class="mx-auto max-w-2xl text-center">
    <div class="section-label reveal">About</div>
    <h2 class="reveal text-[clamp(2rem,5vw,3.5rem)] font-light tracking-[-0.03em] leading-[1.1] mb-8">
      <em class="text-italics">At</em> a glance
    </h2>
    <div class="reveal-stagger space-y-4">
      {siteData.intro.map((p) => (
        <p class="text-sm sm:text-base text-[var(--muted-foreground)] leading-relaxed max-w-xl mx-auto">
          {p}
        </p>
      ))}
    </div>
  </div>
</section>
