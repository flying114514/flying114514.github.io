---
import { siteData } from '../data/content';
---

<section id="about" class="py-24 px-6">
  <div class="mx-auto max-w-2xl">
    <div class="text-center mb-12 reveal">
      <p class="text-[12px] tracking-[0.2em] uppercase text-[var(--text-tertiary)] font-medium mb-3">About</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">关于我</h2>
    </div>

    <div class="card p-8 reveal-stagger">
      {siteData.intro.map((p) => (
        <p class="text-[15px] text-[var(--text-secondary)] leading-relaxed mb-4 last:mb-0">
          {p}
        </p>
      ))}
    </div>
  </div>
</section>
