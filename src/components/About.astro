---
import { siteData } from '../data/content';
---

<section id="about" class="section px-6">
  <div class="mx-auto max-w-3xl text-center">
    <div class="section-label reveal">About</div>
    <h2 class="reveal large-heading mb-10">
      <em class="text-italics">Who</em> I am
    </h2>

    <div class="reveal-stagger space-y-5">
      {siteData.intro.map((p) => (
        <p class="p-60 text-[var(--text)] max-w-2xl mx-auto text-lg leading-relaxed">
          {p}
        </p>
      ))}
    </div>
  </div>
</section>
