---
import { siteData } from '../data/content';
---

<section id="about" class="py-24 px-6 relative">
  <div class="mx-auto max-w-3xl">
    <!-- Section Title -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">关于我</h2>
      <p class="text-sm text-[var(--color-text-muted)] tracking-widest uppercase">About Me</p>
    </div>

    <!-- Intro paragraphs -->
    <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 space-y-4 shadow-sm">
      {siteData.intro.map((p) => (
        <p class="text-[var(--color-text-muted)] leading-relaxed">{p}</p>
      ))}
    </div>
  </div>
</section>
