---
import { siteData } from '../data/content';
---

<section id="contact" class="py-24 px-6 relative bg-[var(--color-surface)]/50">
  <!-- 装饰背景 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute bottom-0 left-1/4 w-1/2 h-1/2 bg-green-500/5 rounded-full blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-3xl relative z-10">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">联系我</h2>
      <p class="text-sm text-[var(--color-text-muted)] tracking-widest uppercase">Contact</p>
    </div>

    <!-- 联系方式 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- GitHub -->
      <a
        href="https://github.com/flying114514"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-surface-hover)] transition-all group"
      >
        <svg class="w-6 h-6 text-[var(--color-accent)]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <div>
          <p class="font-medium group-hover:text-[var(--color-accent)] transition-colors">GitHub</p>
          <p class="text-sm text-[var(--color-text-muted)]">flying114514</p>
        </div>
      </a>

      <!-- CSDN -->
      <a
        href="https://blog.csdn.net/2501_91482594"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-surface-hover)] transition-all group"
      >
        <svg class="w-6 h-6 text-[var(--color-accent)]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-5-5 1.41-1.41L11 14.17l7.59-7.59L20 8l-9 9z"/>
        </svg>
        <div>
          <p class="font-medium group-hover:text-[var(--color-accent)] transition-colors">CSDN</p>
          <p class="text-sm text-[var(--color-text-muted)]">技术博客主页</p>
        </div>
      </a>

      <!-- Email -->
      <button
        class="copy-btn flex items-center gap-3 p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-surface-hover)] transition-all group text-left"
        data-copy="552296010@qq.com"
      >
        <svg class="w-6 h-6 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <div class="flex-1">
          <p class="font-medium group-hover:text-[var(--color-accent)] transition-colors">Email</p>
          <p class="text-sm text-[var(--color-text-muted)]">552296010@qq.com</p>
        </div>
        <span class="copy-hint text-xs text-[var(--color-accent)] opacity-0 group-hover:opacity-100 transition-opacity">点击复制</span>
      </button>
    </div>
  </div>
</section>

<script>
  // 点击复制 Email
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = (btn as HTMLElement).dataset.copy;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const hint = btn.querySelector('.copy-hint') as HTMLElement;
        if (hint) {
          hint.textContent = '已复制!';
          setTimeout(() => {
            hint.textContent = '点击复制';
          }, 2000);
        }
      } catch {
        // Fallback
        window.location.href = `mailto:${email}`;
      }
    });
  });
</script>
