---
import { siteData } from '../data/content';
---

<section id="contact" class="py-24 px-6">
  <div class="mx-auto max-w-xl">
    <div class="text-center mb-14 reveal">
      <p class="text-[12px] tracking-[0.2em] uppercase text-[var(--text-tertiary)] font-medium mb-3">Contact</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">联系我</h2>
    </div>

    <div class="space-y-3 reveal-stagger">
      <!-- GitHub -->
      <a
        href="https://github.com/flying114514"
        target="_blank"
        rel="noopener noreferrer"
        class="card p-5 flex items-center gap-4 group"
      >
        <svg class="w-5 h-5 text-[var(--accent)] flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <div class="flex-1 min-w-0">
          <p class="text-[14px] font-semibold group-hover:text-[var(--accent)] transition-colors duration-[var(--duration-fast)]">GitHub</p>
          <p class="text-[13px] text-[var(--text-tertiary)] truncate">flying114514</p>
        </div>
        <svg class="w-4 h-4 text-[var(--text-tertiary)] opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-fast)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>

      <!-- CSDN -->
      <a
        href="https://blog.csdn.net/2501_91482594"
        target="_blank"
        rel="noopener noreferrer"
        class="card p-5 flex items-center gap-4 group"
      >
        <svg class="w-5 h-5 text-[var(--accent)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <div class="flex-1 min-w-0">
          <p class="text-[14px] font-semibold group-hover:text-[var(--accent)] transition-colors duration-[var(--duration-fast)]">CSDN</p>
          <p class="text-[13px] text-[var(--text-tertiary)] truncate">技术博客主页</p>
        </div>
        <svg class="w-4 h-4 text-[var(--text-tertiary)] opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-fast)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>

      <!-- Email -->
      <button
        class="card p-5 flex items-center gap-4 group w-full text-left"
        data-email="552296010@qq.com"
        id="email-btn"
      >
        <svg class="w-5 h-5 text-[var(--accent)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <div class="flex-1 min-w-0">
          <p class="text-[14px] font-semibold group-hover:text-[var(--accent)] transition-colors duration-[var(--duration-fast)]">Email</p>
          <p class="text-[13px] text-[var(--text-tertiary)] truncate">552296010@qq.com</p>
        </div>
        <span class="copy-feedback text-[12px] text-[var(--accent)] font-medium flex-shrink-0 opacity-0 transition-opacity duration-[var(--duration-fast)]">点击复制</span>
      </button>
    </div>
  </div>
</section>

<script>
  const emailBtn = document.getElementById('email-btn');
  const feedback = emailBtn?.querySelector('.copy-feedback') as HTMLElement;

  emailBtn?.addEventListener('click', async () => {
    const email = emailBtn.dataset.email;
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      if (feedback) {
        feedback.textContent = '已复制!';
        feedback.style.opacity = '1';
        setTimeout(() => {
          feedback.textContent = '点击复制';
          feedback.style.opacity = '0';
        }, 1500);
      }
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });
</script>
