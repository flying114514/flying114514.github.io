---
import type { SkillCategory } from '../types';

interface Props {
  skill: SkillCategory;
}
const { skill } = Astro.props;
---

<div class="card tilt-card p-5 group">
  <div class="flex items-center justify-between mb-3">
    <h4 class="text-[14px] font-semibold text-[var(--accent)]">{skill.name}</h4>
    <span class="text-[11px] text-[var(--text-tertiary)] uppercase tracking-wide">{skill.nameEn}</span>
  </div>
  <ul class="space-y-2">
    {skill.items.map((item) => (
      <li class="flex items-center gap-2.5 text-[13px] text-[var(--text-secondary)]">
        <span class="w-1 h-1 rounded-full bg-[var(--accent)]/40 flex-shrink-0"></span>
        {item}
      </li>
    ))}
  </ul>
</div>
