---
import type { SkillCategory } from '../types';

interface Props { skill: SkillCategory; }
const { skill } = Astro.props;
---

<div class="card group p-5">
  <div class="flex items-center justify-between mb-4">
    <h4 class="text-sm font-medium">{skill.name}</h4>
    <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--muted)]">{skill.nameEn}</span>
  </div>
  <ul class="space-y-2.5">
    {skill.items.map((item) => (
      <li class="flex items-center gap-2.5 text-sm text-[var(--muted-foreground)]">
        <span class="w-1 h-1 rounded-full bg-[var(--muted)] flex-shrink-0"></span>
        {item}
      </li>
    ))}
  </ul>
</div>
