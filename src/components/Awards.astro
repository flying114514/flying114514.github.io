---
import { siteData } from '../data/content';
---

<section id="awards" class="py-24 px-6 relative">
  <div class="mx-auto max-w-3xl">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">荣誉奖项</h2>
      <p class="text-sm text-[var(--color-text-muted)] tracking-widest uppercase">Awards</p>
    </div>

    <!-- 奖项列表 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {siteData.awards.map((award) => (
        <div
          class="flex items-center gap-3 p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm hover:border-[var(--color-accent)]/30 transition-all"
        >
          <span class="text-2xl flex-shrink-0">{award.icon}</span>
          <div>
            <p class="font-semibold text-[var(--color-text)]">{award.title}</p>
            <p class="text-sm text-[var(--color-text-muted)]">{award.subtitle}</p>
          </div>
        </div>
      ))}

      <!-- 教育背景也放在这里 -->
      <div
        class="flex items-center gap-3 p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm hover:border-[var(--color-accent)]/30 transition-all"
      >
        <span class="text-2xl flex-shrink-0">🎓</span>
        <div>
          <p class="font-semibold text-[var(--color-text)]">{siteData.school}</p>
          <p class="text-sm text-[var(--color-text-muted)]">{siteData.major} · 2024.09 - 2028.06</p>
        </div>
      </div>
    </div>
  </div>
</section>
