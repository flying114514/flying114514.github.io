---
import { siteData } from '../data/content';
---

<section id="awards" class="py-16 sm:py-20 px-6">
  <div class="mx-auto max-w-3xl">
    <div class="text-center mb-12 reveal">
      <div class="section-label">Awards & Education</div>
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-light tracking-[-0.03em] leading-[1.1]">
        <em class="text-italics">Accolades</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 reveal-stagger">
      {siteData.awards.map((a) => (
        <div class="card p-4 flex items-center gap-4">
          <span class="text-2xl flex-shrink-0">{a.icon}</span>
          <div>
            <p class="text-sm font-medium leading-snug">{a.title}</p>
            <p class="text-xs text-[var(--muted)] mt-0.5">{a.subtitle}</p>
          </div>
        </div>
      ))}
      <div class="card p-4 flex items-center gap-4">
        <span class="text-2xl flex-shrink-0">🎓</span>
        <div>
          <p class="text-sm font-medium leading-snug">{siteData.school}</p>
          <p class="text-xs text-[var(--muted)] mt-0.5">{siteData.major} · 2024–2028</p>
        </div>
      </div>
    </div>

    <div class="mt-3 text-center reveal">
      <span class="tag">211 / 双一流</span>
    </div>
  </div>
</section>
