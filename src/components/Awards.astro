---
import { siteData } from '../data/content';
---

<section id="awards" class="section px-6 bg-[var(--bg-secondary)]">
  <div class="mx-auto max-w-3xl">
    <div class="text-center mb-20 reveal">
      <div class="section-label">Awards & Education</div>
      <h2 class="large-heading">
        <em class="text-italics">Where</em> I shine
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 reveal-stagger">
      {siteData.awards.map((a) => (
        <div class="track-card p-5 flex items-center gap-4">
          <span class="text-2xl flex-shrink-0">{a.icon}</span>
          <div>
            <p class="text-sm font-medium leading-snug">{a.title}</p>
            <p class="text-xs text-[var(--text-tertiary)] mt-0.5">{a.subtitle}</p>
          </div>
        </div>
      ))}

      <!-- Education card -->
      <div class="track-card p-5 flex items-center gap-4">
        <span class="text-2xl flex-shrink-0">🎓</span>
        <div>
          <p class="text-sm font-medium leading-snug">{siteData.school}</p>
          <p class="text-xs text-[var(--text-tertiary)] mt-0.5">{siteData.major} &middot; 2024 &ndash; 2028</p>
        </div>
      </div>
    </div>

    <!-- School tag -->
    <div class="mt-4 text-center reveal">
      <span class="tag text-xs">211 / 双一流</span>
    </div>
  </div>
</section>
