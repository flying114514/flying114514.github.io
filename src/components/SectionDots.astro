<div id="section-dots" class="fixed right-5 top-1/2 -translate-y-1/2 z-50 hidden md:flex flex-col gap-2.5" aria-hidden="true">
  <button data-section="hero" class="section-dot active" title="首页"></button>
  <button data-section="projects" class="section-dot" title="项目"></button>
  <button data-section="experience" class="section-dot" title="经历"></button>
  <button data-section="skills" class="section-dot" title="技能"></button>
  <button data-section="articles" class="section-dot" title="文章"></button>
  <button data-section="contact" class="section-dot" title="联系"></button>
</div>

<script>
  const ids = ['hero', 'projects', 'experience', 'skills', 'articles', 'contact'];
  const dots = document.querySelectorAll('.section-dot');

  function highlight() {
    const center = window.scrollY + window.innerHeight / 2;
    let active = ids[0];
    for (const id of ids) {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= center) active = id;
    }
    dots.forEach((d) => {
      const btn = d as HTMLElement;
      btn.classList.toggle('active', btn.dataset.section === active);
    });
  }

  window.addEventListener('scroll', highlight, { passive: true });
  highlight();

  dots.forEach((d) => {
    d.addEventListener('click', () => {
      const el = document.getElementById((d as HTMLElement).dataset.section || '');
      el?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>
