---
import { siteData } from '../data/content';
---

<section id="articles" class="py-16 sm:py-20 px-6">
  <div class="mx-auto max-w-3xl">
    <div class="text-center mb-12 reveal">
      <div class="section-label">Articles</div>
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-light tracking-[-0.03em] leading-[1.1]">
        <em class="text-italics">Writing</em>
      </h2>
      <p class="text-sm text-[var(--muted)] mt-3 max-w-lg mx-auto">
        技术思考与经验沉淀，把踩过的坑变成可复用的知识。
      </p>
    </div>

    <div class="space-y-4 reveal-stagger">
      {siteData.articles.map((article) => (
        <a
          href={article.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card p-5 block group/article hover:border-[var(--accent)]/30 transition-all duration-[var(--duration-normal)]"
        >
          <div class="flex items-start gap-4">
            <!-- Platform icon -->
            <span class="text-2xl flex-shrink-0 mt-0.5">{article.platformIcon}</span>

            <div class="flex-1 min-w-0">
              <!-- Title row -->
              <div class="flex items-center gap-2 flex-wrap mb-1.5">
                <h3 class="text-base font-medium group-hover/article:text-[var(--accent)] transition-colors">
                  {article.title}
                </h3>
                <svg
                  class="w-3.5 h-3.5 text-[var(--muted)] opacity-0 -translate-x-1 group-hover/article:opacity-100 group-hover/article:translate-x-0 transition-all duration-[var(--duration-normal)] flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7m10 0v10" />
                </svg>
              </div>

              <!-- Description -->
              <p class="text-sm text-[var(--muted-foreground)] leading-relaxed mb-2.5 line-clamp-2">
                {article.description}
              </p>

              <!-- Meta row -->
              <div class="flex items-center gap-2 flex-wrap">
                <span class="tag text-[11px]">{article.platform}</span>
                <span class="text-[11px] text-[var(--muted)] font-mono">{article.date}</span>
                {article.tags.slice(0, 3).map((t) => (
                  <span class="text-[11px] text-[var(--muted)]/60">{`#${t}`}</span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
