---
import type { Project } from '../types';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const detailId = `detail-${project.slug}`;
---

<article
  class="card tilt-card group cursor-pointer overflow-hidden"
  style="transition-delay: ${index * 80}ms"
>
  <div class="p-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <span class="tag">{project.tag}</span>
      <span class="text-[12px] text-[var(--text-tertiary)] font-mono tracking-tight">{project.period}</span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold mb-1 group-hover:text-[var(--accent)] transition-colors duration-[var(--duration-fast)]">
      {project.title}
    </h3>
    <p class="text-[11px] text-[var(--text-tertiary)] uppercase tracking-wider mb-3">{project.titleEn}</p>

    <!-- Summary -->
    <p class="text-[14px] text-[var(--text-secondary)] leading-relaxed mb-4">
      {project.summary}
    </p>

    <!-- Tech tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {project.techStack.map((t) => (
        <span class="text-[12px] px-2 py-1 rounded-md bg-[var(--accent-subtle)] text-[var(--accent)] font-medium
                     transition-colors duration-[var(--duration-fast)] group-hover:bg-[var(--accent)]/15">
          {t}
        </span>
      ))}
    </div>

    <!-- Expand toggle -->
    <button
      class="inline-flex items-center gap-1.5 text-[13px] font-medium text-[var(--accent)] hover:text-[var(--accent-hover)] transition-colors duration-[var(--duration-fast)]"
      data-toggle={detailId}
      aria-expanded="false"
    >
      <span class="toggle-label">查看技术亮点</span>
      <svg class="w-3 h-3 toggle-chevron transition-transform duration-[var(--duration-normal)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <!-- Expandable detail -->
    <div class="detail-panel" id={detailId}>
      <div>
        <div class="mt-5 pt-5 border-t border-[var(--border-light)] space-y-3.5">
          {project.highlights.map((h) => (
            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-[var(--accent)] mt-2"></span>
              <div>
                <h4 class="text-[14px] font-semibold mb-0.5">{h.title}</h4>
                <p class="text-[13px] text-[var(--text-secondary)] leading-relaxed">{h.content}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  const article = document.currentScript?.parentElement;
  const toggleBtn = article?.querySelector(`[data-toggle="${detailId}"]`) as HTMLElement;
  const panel = document.getElementById(detailId);
  const chevron = toggleBtn?.querySelector('.toggle-chevron') as HTMLElement;
  const label = toggleBtn?.querySelector('.toggle-label') as HTMLElement;

  toggleBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const isOpen = panel?.classList.toggle('open');
    const expanded = isOpen ? 'true' : 'false';
    toggleBtn.setAttribute('aria-expanded', expanded);
    if (chevron) chevron.style.transform = isOpen ? 'rotate(180deg)' : '';
    if (label) label.textContent = isOpen ? '收起' : '查看技术亮点';
  });

  // 3D tilt
  article?.addEventListener('mousemove', (e) => {
    const rect = article.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width - 0.5;
    const y = (e.clientY - rect.top) / rect.height - 0.5;
    article.style.transform = `perspective(1200px) rotateY(${x * 4}deg) rotateX(${-y * 4}deg)`;
  });

  article?.addEventListener('mouseleave', () => {
    article.style.transform = 'perspective(1200px) rotateY(0deg) rotateX(0deg)';
  });
</script>
