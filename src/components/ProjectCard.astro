---
import type { Project } from '../types';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const detailId = `detail-${project.slug}`;
---

<article
  class="track-card group cursor-pointer"
  style="transition-delay: ${index * 80}ms"
>
  <!-- Gradient header area -->
  <div class="relative h-40 bg-gradient-to-br from-white/[0.06] to-white/[0.01] flex items-end p-6">
    <!-- Abstract decoration -->
    <div class="absolute top-4 right-4 opacity-20">
      <div class="w-20 h-20 rounded-full border border-white/20"></div>
      <div class="w-12 h-12 rounded-full border border-white/10 absolute top-4 right-4"></div>
    </div>
    <div>
      <div class="flex items-center gap-3 mb-2">
        <span class="tag">{project.tag}</span>
        <span class="text-xs text-[var(--text-tertiary)] font-mono">{project.period}</span>
      </div>
      <h3 class="text-xl font-medium tracking-tight group-hover:opacity-80 transition-opacity">
        {project.title}
      </h3>
      <p class="text-xs text-[var(--text-tertiary)] font-mono uppercase tracking-wider mt-0.5">{project.titleEn}</p>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 pt-4">
    <p class="p-60 mb-4">
      {project.summary}
    </p>

    <!-- Tech tags -->
    <div class="flex flex-wrap gap-1.5 mb-5">
      {project.techStack.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>

    <!-- Expand toggle -->
    <button
      class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--text)] transition-colors duration-[var(--duration-fast)]"
      data-toggle={detailId}
      aria-expanded="false"
    >
      <span class="toggle-label">Tech Highlights</span>
      <svg class="w-3 h-3 toggle-chevron transition-transform duration-[var(--duration-normal)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <!-- Expandable detail -->
    <div class="detail-panel" id={detailId}>
      <div>
        <div class="mt-5 pt-5 border-t border-[var(--divider)] space-y-4">
          {project.highlights.map((h) => (
            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-[var(--text-tertiary)] mt-2"></span>
              <div>
                <h4 class="text-sm font-medium mb-1">{h.title}</h4>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{h.content}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  const article = document.currentScript?.parentElement;
  const toggleBtn = article?.querySelector(`[data-toggle="${detailId}"]`) as HTMLElement;
  const panel = document.getElementById(detailId);
  const chevron = toggleBtn?.querySelector('.toggle-chevron') as HTMLElement;
  const label = toggleBtn?.querySelector('.toggle-label') as HTMLElement;

  toggleBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const isOpen = panel?.classList.toggle('open');
    const expanded = isOpen ? 'true' : 'false';
    toggleBtn.setAttribute('aria-expanded', expanded);
    if (chevron) chevron.style.transform = isOpen ? 'rotate(180deg)' : '';
    if (label) label.textContent = isOpen ? '收起' : 'Tech Highlights';
  });
</script>
