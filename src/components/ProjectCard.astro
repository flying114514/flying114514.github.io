---
import type { Project } from '../types';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const cardId = `project-${project.slug}`;
const detailId = `detail-${project.slug}`;
---

<div
  class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-sm transition-all duration-300 hover:border-[var(--color-accent)]/30 hover:shadow-md card-3d cursor-pointer"
  data-project-card
  id={cardId}
>
  <!-- 标签 -->
  <div class="flex items-center justify-between mb-4">
    <span
      class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--color-accent-light)] text-[var(--color-accent)] font-medium"
    >
      {project.tag}
    </span>
    <span class="text-xs text-[var(--color-text-muted)] font-mono">{project.period}</span>
  </div>

  <!-- 标题 -->
  <h3 class="text-xl font-bold mb-2 group-hover:text-[var(--color-accent)] transition-colors">
    {project.title}
  </h3>
  <p class="text-xs text-[var(--color-text-muted)]/60 mb-3 uppercase tracking-wide">
    {project.titleEn}
  </p>

  <!-- 简述 -->
  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
    {project.summary}
  </p>

  <!-- 技术栈标签 -->
  <div class="flex flex-wrap gap-2 mb-4">
    {project.techStack.map((tech) => (
      <span
        class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] transition-colors group-hover:bg-[var(--color-accent)]/20"
      >
        {tech}
      </span>
    ))}
  </div>

  <!-- 展开/收起按钮 -->
  <button
    class="text-xs text-[var(--color-accent)] font-medium flex items-center gap-1 hover:underline"
    data-toggle={detailId}
  >
    <span class="toggle-text">查看技术亮点</span>
    <svg
      class="w-3 h-3 transition-transform toggle-arrow"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- 详细亮点（可展开） -->
  <div class="project-detail" id={detailId}>
    <div>
      <div class="mt-4 pt-4 border-t border-[var(--color-border)] space-y-3">
        {project.highlights.map((h) => (
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] mt-2"></span>
            <div>
              <h4 class="text-sm font-semibold text-[var(--color-text)] mb-0.5">{h.title}</h4>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{h.content}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  // 点击展开/收起详情
  const card = document.getElementById(cardId);
  const toggleBtn = card?.querySelector(`[data-toggle="${detailId}"]`);
  const detail = document.getElementById(detailId);
  const arrow = toggleBtn?.querySelector('.toggle-arrow') as HTMLElement;
  const text = toggleBtn?.querySelector('.toggle-text') as HTMLElement;

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    e.preventDefault();
    const isOpen = detail?.classList.toggle('open');
    if (isOpen) {
      if (text) text.textContent = '收起详情';
      if (arrow) arrow.style.transform = 'rotate(180deg)';
    } else {
      if (text) text.textContent = '查看技术亮点';
      if (arrow) arrow.style.transform = 'rotate(0deg)';
    }
  });

  // 3D 卡片悬浮效果
  card?.addEventListener('mousemove', (e) => {
    const rect = card.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const centerX = rect.width / 2;
    const centerY = rect.height / 2;
    const rotateX = (y - centerY) / centerY * -5;
    const rotateY = (x - centerX) / centerX * 5;
    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
  });

  card?.addEventListener('mouseleave', () => {
    card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
  });
</script>
