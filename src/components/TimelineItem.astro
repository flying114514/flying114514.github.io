---
import type { Experience } from '../types';

interface Props {
  experience: Experience;
  isLast?: boolean;
}

const { experience } = Astro.props;
---

<div class="relative pl-10 sm:pl-12">
  <div class="timeline-dot"></div>

  <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--muted)]">{experience.period}</span>

  <div class="mt-2 mb-1 flex items-center gap-2 flex-wrap">
    <h3 class="text-xl font-medium">{experience.company}</h3>
    <span class="text-[11px] text-[var(--muted)] font-mono">{experience.companyEn}</span>
  </div>

  <p class="text-sm font-medium mb-2">{experience.role}</p>
  <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">{experience.content}</p>
</div>
