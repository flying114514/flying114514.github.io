---
import type { Experience } from '../types';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<li class="path-entry">
  <p class="path-period">{experience.period}</p>

  <div class="min-w-0">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-xl font-medium leading-snug">{experience.company}</h3>
      <span lang="en" class="font-mono text-xs text-[var(--muted)]">{experience.companyEn}</span>
    </div>
    <p class="mt-2 text-sm font-medium leading-relaxed">{experience.role}</p>
    <p class="path-description">{experience.content}</p>
  </div>
</li>

<style>
  .path-entry {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .path-period {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .path-period::before {
    content: '';
    flex: 0 0 0.375rem;
    height: 0.375rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    align-self: flex-start;
    margin-top: 0.4rem;
  }

  .path-entry:first-child .path-period::before {
    background: currentColor;
  }

  .path-description {
    max-width: 38rem;
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  @media (min-width: 640px) {
    .path-entry {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 2rem;
      padding-block: 1.75rem;
    }

    .path-period {
      margin-top: 0.25rem;
    }
  }
</style>
