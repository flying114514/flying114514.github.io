---
import type { Experience } from '../types';

interface Props {
  experience: Experience;
  isLast?: boolean;
}

const { experience, isLast = false } = Astro.props;
---

<div class="relative pl-10 sm:pl-12">
  <!-- Dot -->
  <div class="timeline-dot absolute left-0 top-1.5"></div>

  <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-tertiary)]">{experience.period}</span>

  <div class="mt-2 mb-1.5 flex items-center gap-2 flex-wrap">
    <h3 class="text-xl font-medium">
      {experience.company}
    </h3>
    <span class="text-xs text-[var(--text-tertiary)] font-mono">{experience.companyEn}</span>
  </div>

  <p class="text-sm font-medium text-[var(--text)] mb-2">{experience.role}</p>
  <p class="p-60">{experience.content}</p>
</div>
