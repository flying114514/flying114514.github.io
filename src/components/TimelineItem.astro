---
import type { Experience } from '../types';

interface Props {
  experience: Experience;
  isLast?: boolean;
}

const { experience, isLast = false } = Astro.props;
---

<div class="relative pl-14">
  <!-- Node -->
  <div class="absolute left-[11px] top-1.5 w-2.5 h-2.5 rounded-full bg-[var(--accent)] ring-4 ring-[var(--accent-subtle)]"></div>

  <span class="text-[12px] font-mono text-[var(--accent)] tracking-wide font-medium">{experience.period}</span>

  <div class="mt-1 mb-1.5">
    <h3 class="text-lg font-bold inline">
      {experience.company}
    </h3>
    <span class="text-[13px] text-[var(--text-tertiary)] ml-2 font-normal">{experience.companyEn}</span>
  </div>

  <p class="text-[14px] text-[var(--text-secondary)] font-medium mb-2">{experience.role}</p>
  <p class="text-[14px] text-[var(--text-secondary)] leading-relaxed">{experience.content}</p>
</div>
