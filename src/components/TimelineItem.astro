---
import type { Experience } from '../types';

interface Props {
  experience: Experience;
  isLast?: boolean;
}

const { experience, isLast = false } = Astro.props;
---

<div class="relative pl-16">
  <!-- 时间线节点 -->
  <div class="absolute left-4 top-1 w-5 h-5 rounded-full border-2 border-[var(--color-accent)] bg-[var(--color-bg)] flex items-center justify-center text-xs">
    {experience.icon}
  </div>

  <!-- 内容 -->
  <span class="text-xs font-mono text-[var(--color-accent)] tracking-wider">{experience.period}</span>
  <h3 class="text-xl font-semibold mt-1 mb-1">
    {experience.company}
    <span class="text-base font-normal text-[var(--color-text-muted)] ml-2">{experience.companyEn}</span>
  </h3>
  <p class="text-sm text-[var(--color-text-muted)] mb-2 font-medium">{experience.role}</p>
  <p class="text-[var(--color-text-muted)] leading-relaxed text-sm">{experience.content}</p>

  {!isLast && <div class="mt-8"></div>}
</div>
