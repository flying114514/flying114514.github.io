---
import { siteData } from '../data/content';
import TimelineItem from './TimelineItem.astro';
---

<section id="experience" class="py-16 sm:py-20 px-6">
  <div class="mx-auto max-w-3xl">
    <div class="text-center mb-12 reveal">
      <div class="section-label">Experience</div>
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-light tracking-[-0.03em] leading-[1.1]">
        <em class="text-italics">The</em> path
      </h2>
    </div>

    <div class="relative reveal-stagger">
      <div class="timeline-line"></div>
      <div class="space-y-12">
        {siteData.experiences.map((exp, i) => (
          <TimelineItem experience={exp} />
        ))}
      </div>
    </div>
  </div>
</section>
