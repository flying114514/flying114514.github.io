---
import { siteData } from '../data/content';
import TimelineItem from './TimelineItem.astro';
---

<section id="experience" class="section px-6 bg-[var(--bg-secondary)]">
  <div class="mx-auto max-w-3xl">
    <div class="text-center mb-20 reveal">
      <div class="section-label">Experience</div>
      <h2 class="large-heading">
        <em class="text-italics">Where</em> I&rsquo;ve worked
      </h2>
    </div>

    <div class="relative reveal-stagger">
      <!-- Timeline line -->
      <div class="timeline-line left-[7px] sm:left-[9px]"></div>

      <div class="space-y-16">
        {siteData.experiences.map((exp, i) => (
          <TimelineItem
            experience={exp}
            isLast={i === siteData.experiences.length - 1}
          />
        ))}
      </div>
    </div>
  </div>
</section>
