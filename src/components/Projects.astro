---
import { siteData } from '../data/content';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="py-16 sm:py-20 px-6 bg-[var(--background-secondary)]">
  <div class="mx-auto max-w-6xl">
    <div class="text-center mb-12 reveal">
      <div class="section-label">Projects</div>
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-light tracking-[-0.03em] leading-[1.1] mb-4">
        <em class="text-italics">What</em> I&rsquo;ve built
      </h2>
      <p class="text-xs text-[var(--muted)] font-mono uppercase tracking-wider">
        AI Agent · RAG · LLM Engineering · High-Concurrency
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 reveal-stagger">
      {siteData.projects.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>
  </div>
</section>
