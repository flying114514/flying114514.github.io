---
import { siteData } from '../data/content';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <div class="text-center mb-16 reveal">
      <p class="text-[12px] tracking-[0.2em] uppercase text-[var(--text-tertiary)] font-medium mb-3">Projects</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">项目经历</h2>
      <p class="text-[15px] text-[var(--text-secondary)] max-w-lg mx-auto leading-relaxed">
        AI Agent 决策、RAG 检索增强、LLM 工程化与高并发架构的实践项目。
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 reveal-stagger">
      {siteData.projects.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>
  </div>
</section>
