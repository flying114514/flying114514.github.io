---
import { siteData } from '../data/content';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="py-24 px-6 relative bg-[var(--color-surface)]/50">
  <!-- 装饰背景 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/4 -left-1/4 w-1/2 h-1/2 bg-[var(--color-accent)]/5 rounded-full blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-5xl relative z-10">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">项目经历</h2>
      <p class="text-sm text-[var(--color-text-muted)] tracking-widest uppercase">Projects</p>
      <p class="text-[var(--color-text-muted)] mt-3 max-w-xl mx-auto">
        独立设计与开发的项目，涵盖 AI Agent 决策、RAG 检索增强、LLM 工程化与高并发架构。
      </p>
    </div>

    <!-- 项目卡片网格 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {siteData.projects.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>
  </div>
</section>
