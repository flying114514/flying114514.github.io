<script>
  // ============================================================
  // Click Particles — subtle monochrome burst matching the
  // Midday-inspired theme (thin ripple + fine drifting dust).
  // Respects prefers-reduced-motion and the active theme color.
  // ============================================================

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && document.body) {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    canvas.setAttribute('aria-hidden', 'true');
    canvas.style.cssText =
      'position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9998;';
    document.body.appendChild(canvas);

    let width = 0;
    let height = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Theme-aware base color (rgb triplet) — reads the live theme on every click.
    const baseColor = () =>
      document.documentElement.getAttribute('data-theme') === 'light'
        ? '10, 10, 10' // near-black foreground in light mode
        : '250, 250, 250'; // near-white foreground in dark mode

    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

    const particles = [];
    let rafId = null;

    const spawn = (x, y) => {
      // Thin expanding ripple
      particles.push({
        type: 'ring',
        x,
        y,
        maxRadius: 42,
        life: 0,
        duration: 600,
      });

      // Fine dust drifting outward
      const count = 6;
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 70 + Math.random() * 80; // px/s
        particles.push({
          type: 'dot',
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 15, // slight upward bias for a natural arc
          gravity: 130, // px/s^2, gentle downward fall
          size: 0.8 + Math.random() * 1.3,
          life: 0,
          duration: 500 + Math.random() * 240,
        });
      }

      // Hard cap so rapid clicking can never pile up unboundedly
      if (particles.length > 400) {
        particles.splice(0, particles.length - 400);
      }

      if (!rafId) {
        rafId = requestAnimationFrame(tick);
      }
    };

    let last = performance.now();

    const tick = (now) => {
      const dt = Math.min((now - last) / 1000, 0.033); // clamp to ~30fps floor
      last = now;

      ctx.clearRect(0, 0, width, height);
      const color = baseColor();

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life += dt * 1000;
        const progress = p.life / p.duration;

        if (progress >= 1) {
          particles.splice(i, 1);
          continue;
        }

        if (p.type === 'ring') {
          const radius = p.maxRadius * easeOutCubic(progress);
          const opacity = 0.28 * (1 - progress);
          ctx.beginPath();
          ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(${color}, ${opacity})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        } else {
          const friction = Math.pow(0.94, dt * 60);
          p.vx *= friction;
          p.vy = p.vy * friction + p.gravity * dt;
          p.x += p.vx * dt;
          p.y += p.vy * dt;

          const opacity = 0.4 * (1 - progress);
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${color}, ${opacity})`;
          ctx.fill();
        }
      }

      if (particles.length > 0) {
        rafId = requestAnimationFrame(tick);
      } else {
        rafId = null;
        ctx.clearRect(0, 0, width, height);
      }
    };

    document.addEventListener('click', (e) => {
      spawn(e.clientX, e.clientY);
    });
  }
</script>
