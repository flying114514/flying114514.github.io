---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteData } from '../../data/content';

const project = siteData.projects.find(p => p.slug === 'neo-digital-employee')!;
---

<BaseLayout
  title={`${project.title} | 刘辉`}
  description={project.summary}
>
  <div class="min-h-screen">
    <div class="mx-auto max-w-3xl px-6 pt-8">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-[var(--muted)] hover:text-[var(--foreground)] transition-colors font-mono">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m0 0l7 7m-7-7l7-7"/>
        </svg>
        返回首页
      </a>
    </div>

    <header class="mx-auto max-w-3xl px-6 pt-12 pb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="tag text-xs">{project.tag}</span>
        <span class="text-xs text-[var(--muted)] font-mono">{project.period}</span>
      </div>
      <h1 class="text-[clamp(2rem,5vw,3rem)] font-light tracking-[-0.03em] leading-[1.15] mb-2">
        {project.title}
      </h1>
      <p class="text-sm text-[var(--muted)] font-mono uppercase tracking-wider">{project.titleEn}</p>
    </header>

    <main class="mx-auto max-w-3xl px-6 pb-20 space-y-10">
      <section>
        <h2 class="text-lg font-medium mb-3">概述</h2>
        <p class="text-[var(--muted-foreground)] leading-relaxed">
          {project.summary}
        </p>
        <p class="text-[var(--muted-foreground)] leading-relaxed mt-3">
          实习期间我负责执行层三个核心模块：<strong>红黄绿灯分级容错协议</strong>（借鉴断路器模型，让 Agent 在自主重试和人工介入之间做合理决策）、<strong>经验闭环学习机制</strong>（L1 即时反思 → L2 聚合分析 → L3 策略注入，让 Agent 越用越好）、<strong>技能包流水线</strong>（模板方法 + 策略模式 + YAML 声明式配置，让新能力以插件形式接入）。
        </p>
        <div class="flex flex-wrap gap-2 mt-4">
          {project.techStack.map(t => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </section>

      {project.highlights.map((h) => (
        <section>
          <h2 class="text-lg font-medium mb-2">{h.title}</h2>
          <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">{h.content}</p>
        </section>
      ))}

      <footer class="pt-8 text-center">
        <a href="/" class="inline-flex items-center gap-1.5 text-sm text-[var(--muted)] hover:text-[var(--foreground)] transition-colors font-mono">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m0 0l7 7m-7-7l7-7"/>
          </svg>
          返回首页
        </a>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.15em 0.55em;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 500;
    background: rgba(255,255,255,0.06);
    color: var(--muted);
    border: 1px solid var(--border);
  }
</style>
